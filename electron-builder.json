{
  "appId": "md.office.app",
  "productName": "office.md",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "dist-electron/**"
  ],
  "publish": {
    "provider": "github",
    "owner": "risajef",
    "repo": "office.md",
    "releaseType": "release",
    "publishAutoUpdate": true
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "artifactName": "office.md-${version}-linux-x64.AppImage",
    "category": "Office"
  },
  "win": {
    "icon": "build/office-md.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "office.md-${version}-windows-x64.exe"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false
  }
}
